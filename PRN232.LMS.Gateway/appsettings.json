{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "PRN232-LMS-SuperSecretKey-ChangeInProduction-AtLeast32Chars!",
    "Issuer": "PRN232.LMS.API",
    "Audience": "PRN232.LMS.Client"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "students-route": {
        "ClusterId": "student-cluster",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/{version}/students/{**catch-all}"
        }
      },
      "courses-route": {
        "ClusterId": "course-cluster",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/{version}/courses/{**catch-all}"
        }
      },
      "enrollments-route": {
        "ClusterId": "course-cluster",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/{version}/enrollments/{**catch-all}"
        }
      },
      "semesters-route": {
        "ClusterId": "course-cluster",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/{version}/semesters/{**catch-all}"
        }
      },
      "subjects-route": {
        "ClusterId": "course-cluster",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/{version}/subjects/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://identity-service:8080"
          }
        }
      },
      "student-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://student-service:8080"
          }
        }
      },
      "course-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://course-service:8080"
          }
        }
      }
    }
  }
}
